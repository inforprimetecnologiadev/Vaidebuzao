<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VaiDeBuzao" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vdb_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VaiDeBuzao.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vdb_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.VaiDeBuzao</item>
    </style>
</resources>
